POSTGRES_USER=rental_prod
POSTGRES_PASSWORD=changeme-generate-a-strong-random-value
POSTGRES_DB=rental_platform_prod
JWT_ACCESS_SECRET=changeme-openssl-rand-hex-32
JWT_REFRESH_SECRET=changeme-openssl-rand-hex-32
# Used for backend CORS only — the frontend build itself doesn't need to know
# its own origin (see docker-compose.prod.yml). Only matters if you're calling
# the API from a different origin than the site itself.
PUBLIC_ORIGIN=http://your-server-ip-or-domain

# Optional: leave empty to disable Google sign-in. From Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID (Web application). Must
# list PUBLIC_ORIGIN as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
