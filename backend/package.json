{
  "name": "rental-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate:create": "dotenv -e .env -- node-pg-migrate -m src/db/migrations create",
    "migrate:up": "dotenv -e .env -- node-pg-migrate -m src/db/migrations up",
    "migrate:down": "dotenv -e .env -- node-pg-migrate -m src/db/migrations down",
    "migrate:test:up": "dotenv -e .env.test -- node-pg-migrate -m src/db/migrations up",
    "migrate:test:down": "dotenv -e .env.test -- node-pg-migrate -m src/db/migrations down",
    "seed": "tsx src/db/seed.ts",
    "promote-admin": "tsx src/db/promote-admin.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run migrate:test:up",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.5",
    "multer": "^2.0.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  }
}
