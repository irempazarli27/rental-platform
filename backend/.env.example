NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://rental:rental_dev_password@localhost:5432/rental_platform

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:3000

# Optional: leave unset to disable Google sign-in. Get this from Google Cloud
# Console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
MAX_VIDEO_SIZE_MB=100

# Number of reverse proxies in front of the API (nginx/Caddy = 1, direct = 0)
TRUST_PROXY_HOPS=1

# Minimum trust score (0-100) needed to request a high-risk item
HIGH_RISK_MIN_TRUST=40

# Demo verification: steps without a real provider return their code in the API
# response instead of sending it. Set to "false" once every step has one.
VERIFICATION_DEMO_MODE=true

# Optional SMTP server for email verification codes. With SMTP_HOST unset the
# email step stays in demo mode. Port 465 uses implicit TLS, others STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "Paylaşımlık <you@example.com>". Defaults to SMTP_USER.
MAIL_FROM=

# Optional AI features (review summaries, price suggestions, handover
# comparison, help assistant). Empty GEMINI_API_KEY turns them all off.
# Model names are configurable because providers rename them often.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_VISION=gemini-3.8-flash
# Calls to the model allowed per 24 hours, across everyone / per user.
AI_DAILY_REQUEST_CAP=500
AI_USER_DAILY_CAP=30
