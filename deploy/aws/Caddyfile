# Caddy obtains and renews the Let's Encrypt certificate for {$DOMAIN} by itself
# (it needs ports 80 and 443 reachable and the domain's A record pointing here).
{$DOMAIN} {
	encode gzip

	# Video uploads for handover records (the backend caps them at 100MB).
	request_body {
		max_size 120MB
	}

	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /uploads/* {
		reverse_proxy backend:4000
	}
	handle /health {
		reverse_proxy backend:4000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
